# ============================================================
# Lager-Management-System - Umgebungsvariablen (Beispiel)
# Kopiere diese Datei zu .env und ersetze alle Platzhalter.
# NIEMALS .env in Git einchecken!
# ============================================================

# --- Datenbank ---
DB_HOST=db
DB_NAME=lagerdb
DB_USER=lager
DB_PASSWORD=BITTE_AENDERN

# --- Spring Boot App ---
# BCrypt-Hash des Operator-Passworts.
# Generieren: htpasswd -bnBC 10 "" DEIN_PASSWORT | tr -d ':\n'
# WICHTIG: Jedes $-Zeichen im Hash MUSS in dieser Datei als $$ escaped werden!
# Docker Compose interpretiert einfache $-Zeichen als Variablen-Referenz
# und kuerzt den Hash ab. Beispiel: $2a wird zu $$2a
APP_OPERATOR_PASSWORD_HASH=$$2a$$10$$BEISPIEL_HASH_HIER_ERSETZEN

# --- Dateipfade (im Container) ---
FILES_BASE_PATH=/app/files

# --- Mail (optional, Standard: deaktiviert) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.beispiel.de
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=lager@beispiel.de
